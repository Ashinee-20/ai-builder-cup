# Public product label
NEXT_PUBLIC_PRODUCT_NAME=ChalkEvo

# Live AI mode (server only). Use Vertex AI or a scoped API key; never commit values.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
SAHAYAK_AI_ACCESS_TOKEN=
CHALKEVO_WORKSPACE_ACCESS_CODE=

# Google Forms OAuth JSON. Store in Secret Manager in production; never commit real values.
GOOGLE_FORMS_CREDENTIALS_JSON=
GOOGLE_FORMS_TOKEN_JSON=

# Firestore uses Application Default Credentials / the Cloud Run runtime identity.
FIRESTORE_DATABASE_ID=(default)

# Firebase web configuration (public identifiers, not service credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin / Cloud Tasks configuration should use workload identity in Cloud Run.
FIREBASE_PROJECT_ID=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=
WORKER_URL=
