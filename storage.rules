rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /tenants/{tenantId}/recordings/{recordingId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.token.tenantId == tenantId && request.auth.token.role == 'teacher' && request.resource.size < 100 * 1024 * 1024;
    }
  }
}
